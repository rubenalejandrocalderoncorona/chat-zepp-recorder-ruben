{
    "configVersion": "v3",
    "app": {
        "appId": 1029480,
        "appName": "AI Chat",
        "appType": "app",
        "version": {
            "code": 1,
            "name": "2.3.1"
        },
        "icon": "icon.png",
        "vender": "zepp",
        "description": "empty app"
    },
    "includeAssets": {
        "mzfw": "./node_modules/mzfw/assets",
        "icon": "./assets/common/icon"
    },
    "includeRawAssets": {
        "mzfw": "./node_modules/mzfw/assets_raw"
    },
    "defaultLanguage": "en-US",
    "withBundleGlobals": true,
    "permissions": [
        "data:os.device.info",
        "device:os.mic"
    ],
    "targetZeppOS": "1.0.0",
    "targets": {
        "modern": {
            "targetZeppOS": "3.0.0",
            "designWidth": 480,
            "platforms": [
                "active",
                "active_2",
                "active_edge",
                "balance",
                "bip5unity",
                "cheetah",
                "cheetah_pro",
                "cheetah_square",
                "falcon",
                "gtr4",
                "gtr4le",
                "gts4",
                "trex3",
                "trex_ultra"
            ],
            "module": {
                "page": {
                    "pages": [
                        "page/SplashScreen",
                        "page/HomePageScreen",
                        "page/NewsViewScreen",
                        "page/PrivacyWarningScreen",
                        "page/ChatViewScreen",
                        "page/InputKeyboardScreen",
                        "page/InputVoiceScreen",
                        "page/SettingsScreen",
                        "page/SettingsKeyboardScreen",
                        "page/SettingsFontSizeScreen",
                        "page/AboutScreen",
                        "page/DonateScreen"
                    ]
                },
                "//secondary-widget": {
                    "widgets": [
                        {
                            "path": "secondary-widget/index",
                            "icon": "icon.png",
                            "name": "AI Chat",
                            "runtime": {
                                "type": "js"
                            }
                        }
                    ]
                },
                "app-widget": {
                    "widgets": [
                        {
                            "path": "app-widget/index",
                            "icon": "icon.png",
                            "name": "AI Chat",
                            "runtime": {
                                "type": "js"
                            }
                        }
                    ]
                },
                "app-side": {
                    "path": "app-side/index"
                }
            }
        },
        "legacy": {
            "targetZeppOS": "1.0.0",
            "designWidth": 480,
            "platforms": [
                "bip5",
                "gtr_mini",
                "gts4mini",
                "band7",
                "gtr3pro",
                "gtr3",
                "gts3",
                "trex2",
                "mi_band7"
            ],
            "moduleFrom": "modern"
        }
    }
}
